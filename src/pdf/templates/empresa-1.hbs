<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{titulo}}</title>
  <style>
    :root {
      --brand: #c51b1b;
      --ink: #111;
      --line: #d9d9d9;
      --thead: #c51b1b;
    }

    @page {
      size: Letter;
      margin: 0;
    }

    @font-face {
      font-family: "InterVar";
      src: url("assets/fonts/Inter-VariableFont.ttf") format("truetype-variations");
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "InterVar", Arial, Helvetica, sans-serif;
      font-size: 12px;
      margin: 0;
      padding: 0;
    }

    .page-container {
      position: relative;
      width: 215.9mm;
      min-height: 279.4mm;
      break-after: page;
      page-break-after: always;
    }

    .page-container:last-child {
      break-after: auto;
      page-break-after: auto;
    }

    .page-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 215.9mm;
      height: 279.4mm;
      z-index: 0;
      pointer-events: none;
    }

    .page-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .content-area {
      position: relative;
      z-index: 1;
      padding-top: 23mm;
      padding-left: 10mm;
      padding-right: 10mm;
      min-height: 279.4mm;
      display: flex;
      flex-direction: column;
    }

    .fecha {
      text-align: right;
      color: #333;
      margin-bottom: 15px;
    }

    .dest {
      font-weight: 700;
      line-height: 1.45;
      margin-top: 10px;
    }

    .presente {
      font-weight: 800;
      margin-top: 5px;
    }

    .intro {
      margin-top: 10px;
      line-height: 1.55;
      color: #222;
    }

    .label {
      font-weight: 700;
    }

    .folio {
      text-align: center;
      font-weight: 800;
      margin-bottom: 15px;
      font-size: 14px;
      color: #143444;
    }

    .table-wrap {
      margin-top: 15px;
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    thead th {
      background: var(--thead);
      color: #fff;
      font-weight: 700;
      border: 1px solid var(--thead);
      padding: 8px;
      font-size: 12px;
      text-align: left;
    }

    tbody td {
      border: 1px solid var(--line);
      padding: 6px 8px;
      font-size: 12px;
      background: #fff;
      vertical-align: top;
      white-space: pre-line;
      word-wrap: break-word;
      word-break: break-word;
    }

    .center {
      text-align: center;
    }

    .right {
      text-align: right;
    }

    th:nth-child(1), td:nth-child(1) { width: 10%; }
    th:nth-child(2), td:nth-child(2) { width: 40%; }
    th:nth-child(3), td:nth-child(3) { width: 12%; }
    th:nth-child(4), td:nth-child(4) { width: 10%; }
    th:nth-child(5), td:nth-child(5) { width: 14%; }
    th:nth-child(6), td:nth-child(6) { width: 14%; }

    .totals {
      display: flex;
      justify-content: flex-end;
      margin-top: 15px;
    }

    .totals table {
      width: 70mm;
      border-collapse: collapse;
    }

    .totals td {
      padding: 6px 8px;
      border-left: 1px solid var(--line);
      border-right: 1px solid var(--line);
    }

    .totals tr:first-child td {
      border-top: 1px solid var(--line);
    }

    .totals tr:last-child td {
      border-bottom: 1px solid var(--line);
    }

    .totals .label {
      font-weight: 700;
      background: #f6f6f6;
      width: 35%;
    }

    .totals .value {
      text-align: right;
      width: 65%;
    }

    .footer-section {
      padding-top: 20px;
    }

    .contact-info {
      margin-top: 15px;
      font-size: 10px;
      color: #666;
      line-height: 1.4;
      text-align: center;
      padding-top: 8px;
    }

    .condiciones-box {
      margin-top: 20px;
    }

    .condiciones-title {
      margin-bottom: 6px;
      color: #143444;
      font-weight: 800;
    }

    .signature {
      margin-top: 30px;
      text-align: center;
    }

    .signature img {
      height: 70px;
      display: block;
      margin: 0 auto 8px auto;
    }

    .signature-name {
      font-weight: 600;
      margin-top: 10px;
    }
  </style>
</head>

<body>

{{#if items}}
  {{#each (smartChunk_e1 items)}}
  <div class="page-container">
    <div class="page-bg"><img src="{{../assets.bg}}" alt="membrete"></div>
    <div class="content-area">

      {{#if (eq @index 0)}}
        <!-- Primera página: encabezado completo -->
        <div class="folio">{{../folio}}</div>
        <div class="fecha">{{../lugar}}; a {{../fecha}}</div>
        <div class="dest">{{../destinatario}}</div>
        <div class="presente">{{../presente}}</div>
        <div class="intro">
          <div><span class="label">Solicitud de cotización:</span> {{../titulo}}</div>
          <div><span class="label">No. de conceptos:</span> {{../items.length}}</div>
        </div>
        <div class="intro">{{{../descripcion}}}</div>
      {{else}}
        <div class="folio">{{../folio}} (continuación)</div>
      {{/if}}

      <!-- Tabla de items -->
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th class="center">No.</th>
              <th>Descripción</th>
              <th class="center">Unidad</th>
              <th class="center">Cant.</th>
              <th class="right">Unitario</th>
              <th class="right">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            {{#each this}}
            <tr>
              <td class="center">{{this.globalIndex}}</td>
              <td class="desc-cell">{{{this.nombre}}}</td>
              <td class="center">{{this.unidad}}</td>
              <td class="center">{{this.cantidad}}</td>
              <td class="right">{{money this.unitario}}</td>
              <td class="right">{{money this.parcial}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      {{#if @last}}
        {{#if (needsSeparateImportantPage_e1 ../items)}}
        {{else}}
          <div class="footer-section">
            <div class="totals">
              <table class="totals-table">
                <tr><td class="label">Subtotal</td><td class="value">{{money ../totales.subtotal}}</td></tr>
                <tr><td class="label">IVA ({{../ivaPct}}%)</td><td class="value">{{money ../totales.iva}}</td></tr>
                <tr><td class="label">Monto Total</td><td class="value">{{money ../totales.total}}</td></tr>
              </table>
            </div>
            <div style="margin-top: 10px;">
              <span class="label">Importe en letra:</span> {{../totalEnLetra}}
            </div>
            {{#if ../condiciones}}
            <div class="condiciones-box">
              <div class="condiciones-title">Condiciones</div>
              <div>{{{../condiciones}}}</div>
            </div>
            {{/if}}
            <div class="signature">
              <div style="font-weight:600; margin-bottom:8px;">Atentamente</div>
              {{#if ../incluirFirma}}
                {{#if ../assets.firma}}<img src="{{../assets.firma}}" alt="firma">{{/if}}
              {{else}}
                <div style="height:70px;"></div>
              {{/if}}
              <div class="signature-name">
                {{#if ../firmanteNombre}}{{{../firmanteNombre}}}{{else}}Responsable de Ventas{{/if}}
              </div>
            </div>
            <div class="contact-info">
              {{#if ../contactoTelefono}}{{../contactoTelefono}}<br>{{/if}}
              {{#if ../contactoRFC}}RFC: {{../contactoRFC}}<br>{{/if}}
              {{#if ../contactoEmail}}{{../contactoEmail}}<br>{{/if}}
              {{#if ../contactoEmpresa}}{{../contactoEmpresa}}<br>{{/if}}
              {{#if ../contactoDireccion}}{{../contactoDireccion}}<br>{{/if}}
              {{#if ../contactoCiudad}}{{../contactoCiudad}}<br>{{/if}}
            </div>
          </div>
        {{/if}}
      {{/if}}
    </div>
  </div>
  {{/each}}

  {{#if (needsSeparateImportantPage_e1 items)}}
  <div class="page-container">
    <div class="page-bg"><img src="{{assets.bg}}" alt="membrete"></div>
    <div class="content-area">
      <div class="footer-section" style="margin-top: 0; padding-top: 0;">
        <div class="totals">
          <table class="totals-table">
            <tr><td class="label">Subtotal</td><td class="value">{{money totales.subtotal}}</td></tr>
            <tr><td class="label">IVA ({{ivaPct}}%)</td><td class="value">{{money totales.iva}}</td></tr>
            <tr><td class="label">Monto Total</td><td class="value">{{money totales.total}}</td></tr>
          </table>
        </div>
        <div style="margin-top: 10px;">
          <span class="label">Importe en letra:</span> {{totalEnLetra}}
        </div>
        {{#if condiciones}}
        <div class="condiciones-box">
          <div class="condiciones-title">Condiciones</div>
          <div>{{{condiciones}}}</div>
        </div>
        {{/if}}
        <div class="signature">
          <div style="font-weight:600; margin-bottom:8px;">Atentamente</div>
          {{#if incluirFirma}}
            {{#if assets.firma}}<img src="{{assets.firma}}" alt="firma">{{/if}}
          {{else}}
            <div style="height:70px;"></div>
          {{/if}}
          <div class="signature-name">
            {{#if firmanteNombre}}{{{firmanteNombre}}}{{else}}Responsable de Ventas{{/if}}
          </div>
        </div>
        <div class="contact-info">
          {{#if contactoTelefono}}{{contactoTelefono}}<br>{{/if}}
          {{#if contactoRFC}}RFC: {{contactoRFC}}<br>{{/if}}
          {{#if contactoEmail}}{{contactoEmail}}<br>{{/if}}
          {{#if contactoEmpresa}}{{contactoEmpresa}}<br>{{/if}}
          {{#if contactoDireccion}}{{contactoDireccion}}<br>{{/if}}
          {{#if contactoCiudad}}{{contactoCiudad}}<br>{{/if}}
        </div>
      </div>
    </div>
  </div>
  {{/if}}

{{else}}
  <div class="page-container">
    <div class="page-bg"><img src="{{assets.bg}}" alt="membrete"></div>
    <div class="content-area">
      <div style="text-align:center; padding-top:100px;">
        <h3>No hay items en esta cotización</h3>
      </div>
    </div>
  </div>
{{/if}}

</body>
</html>