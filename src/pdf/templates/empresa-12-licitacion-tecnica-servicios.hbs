<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{tituloLicitacion}}</title>
  <style>
    :root { --primary: #164428; --secondary: #143C23; --bg-light: #E2EFD9; --line: #bdc3c7; }

    @page { size: Letter; margin: 0 7mm 0; }

    @font-face {
      font-family: "Calibri";
      src: url("assets/fonts/Calibri.ttf") format("truetype");
      font-weight: 400; font-style: normal; font-display: swap;
    }
    @font-face {
      font-family: "Calibri";
      src: url("assets/fonts/Calibri-Bold.ttf") format("truetype");
      font-weight: 700; font-style: normal; font-display: swap;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: "Calibri", Arial, Helvetica, sans-serif;
      font-size: 11pt;
      color: #111;
    }

    .page-container {
      position: relative;
      width: 215.9mm;
      min-height: 279.4mm;
      break-after: page;
      page-break-after: always;
    }

    .page-container:last-child { break-after: auto; page-break-after: auto; }

    .page-bg {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: 0; pointer-events: none;
    }

    .page-bg img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .content-area {
      position: relative;
      z-index: 1;
      padding-top: 30mm;
      padding-left: 20mm;
      padding-right: 12mm;
      padding-bottom: 40mm;
      min-height: 279.4mm;
      display: flex;
      flex-direction: column;
    }

    .header-block { text-align: center; margin-bottom: 10px; line-height: 1.6; }
    .header-block div { font-weight: 400; font-size: 11pt; }

    .fecha-line { text-align: left; font-size: 11pt; margin-bottom: 8px; color: var(--primary); font-weight: 700; }

    .dest-block { margin-bottom: 8px; line-height: 1.6; }
    .dest-block .dest-nombre,
    .dest-block .presente { font-weight: 700; font-size: 11pt; color: var(--primary); }

    .licitante-line { font-size: 11pt; margin-bottom: 8px; }
    .licitante-line strong { font-weight: 700; }

    .table-wrap { margin-top: 8px; width: 100%; }

    table { width: 100%; border-collapse: collapse; table-layout: fixed; }

    thead th {
      background-color: var(--secondary); color: #fff; font-weight: 700;
      border: 1px solid #000; padding: 8px 5px;
      font-size: 10pt; text-align: center; vertical-align: middle;
      line-height: 1.3;
    }

    tbody td {
      border: 1px solid #000; padding: 6px 6px; font-size: 10.5pt;
      background-color: var(--bg-light); vertical-align: top;
      word-wrap: break-word; word-break: break-word; white-space: pre-line;
    }

    tr.continuation td { background-color: #f0f7eb; border-top: none; }

    .center { text-align: center; }
    .right  { text-align: right; }

    th:nth-child(1), td:nth-child(1) { width: 10%; }
    th:nth-child(2), td:nth-child(2) { width: 10%; }
    th:nth-child(3), td:nth-child(3) { width: 46%; }
    th:nth-child(4), td:nth-child(4) { width: 12%; }
    th:nth-child(5), td:nth-child(5) { width: 10%; }
    th:nth-child(6), td:nth-child(6) { width: 12%; }

    .footer-block { margin-top: 12px; display: flex; flex-direction: column; flex: 1; }

    .condicion-line { font-size: 11pt; margin-bottom: 4px; line-height: 1.5; }
    .condicion-line strong { font-weight: 700; }

    .firmante-block {
      margin-top: auto; padding-top: 14px;
      text-align: left; font-size: 11pt; line-height: 1.65;
    }
    .firmante-block .atentamente { font-weight: 600; color: var(--primary); margin-bottom: 8px; }
    .firmante-block .nombre { font-weight: 700; color: var(--primary); }

    .continuacion-header { text-align: center; margin-bottom: 8px; font-size: 11pt; }
  </style>
</head>
<body>

{{#if rows}}
  {{#each (licitSmartChunkServicios12 rows)}}
  <div class="page-container">
    <div class="page-bg"><img src="assets/emp12.png" alt="membrete"></div>
    <div class="content-area">

      {{#if (licit_eq @index 0)}}
        <div class="header-block">
          <div>Oficialía Mayor del Poder Ejecutivo del Estado de Hidalgo</div>
          <div>Licitación Pública Nacional No. {{../numeroLicitacion}}</div>
          <div>{{../tituloLicitacion}}</div>
          <div>{{../documentoVI}}</div>
          <div>{{../anexo}}</div>
          <div>{{../tipoDocumento}}</div>
        </div>
        <div class="fecha-line">{{../lugar}}, a {{../fecha}}</div>
        <div class="dest-block">
          <div class="dest-nombre">{{../destinatario}}</div>
          <div class="presente">{{../presente}}</div>
        </div>
        <div class="licitante-line">
          <strong>Nombre del licitante:</strong> {{../nombreLicitante}}
        </div>
      {{else}}
        <div class="continuacion-header">
          <div>Documento {{licit_roman @index}} - {{../anexo}}</div>
        </div>
      {{/if}}

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th class="center">CONCEPTO</th>
              <th class="center">SUB-<br>CONCEPTO</th>
              <th class="center">DESCRIPCIÓN COMPLETA Y DETALLADA DEL<br>SUBCONCEPTO</th>
              <th class="center">UNIDAD<br>DE<br>MEDIDA</th>
              <th class="center">CANTIDAD<br>OFERTADA</th>
              <th class="center">MARCA</th>
            </tr>
          </thead>
          <tbody>
            {{#each this}}
            {{#if this.isContinuation}}
            <tr class="continuation">
              <td class="center"></td>
              <td class="center"></td>
              <td>{{this.descripcion}}</td>
              <td class="center"></td>
              <td class="center"></td>
              <td class="center"></td>
            </tr>
            {{else}}
            <tr>
              {{#if this.isFirstInConcepto}}
              <td class="center" rowspan="{{this.rowspan}}">{{this.concepto}}</td>
              {{/if}}
              <td class="center">{{this.subconcepto}}</td>
              <td>{{this.descripcion}}</td>
              <td class="center">{{this.unidad}}</td>
              <td class="center">{{this.cantidad}}</td>
              <td class="center">{{this.marca}}</td>
            </tr>
            {{/if}}
            {{/each}}
          </tbody>
        </table>
      </div>

      {{#if @last}}
        {{#if (licitNeedsSeparatePageServicios12 ../rows)}}
        {{else}}
          <div class="footer-block">
            <div>
              <div class="condicion-line"><strong>Condiciones de pago:</strong> {{../condicionPago}}</div>
              <div class="condicion-line"><strong>Vigencia de la cotización:</strong> {{../vigencia}}</div>
              <div class="condicion-line"><strong>Plazo y condiciones de los bienes:</strong> {{../plazoCondiciones}}</div>
              <div class="condicion-line"><strong>Lugar de entrega de los bienes:</strong> {{../lugarEntrega}}</div>
            </div>
            <div class="firmante-block">
              <div class="atentamente">A T E N T A M E N T E</div>
              {{#if ../firmanteNombre}}<div class="nombre">{{../firmanteNombre}}</div>{{/if}}
              {{#if ../firmanteCargo}}<div class="nombre">{{../firmanteCargo}}</div>{{/if}}
              <div class="nombre">{{../firmanteEmpresa}}</div>
            </div>
          </div>
        {{/if}}
      {{/if}}

    </div>
  </div>
  {{/each}}

  {{#if (licitNeedsSeparatePageServicios12 rows)}}
  <div class="page-container">
    <div class="page-bg"><img src="assets/emp12.png" alt="membrete"></div>
    <div class="content-area">
      <div class="footer-block">
        <div>
          <div class="condicion-line"><strong>Condiciones de pago:</strong> {{condicionPago}}</div>
          <div class="condicion-line"><strong>Vigencia de la cotización:</strong> {{vigencia}}</div>
          <div class="condicion-line"><strong>Plazo y condiciones de los bienes:</strong> {{plazoCondiciones}}</div>
          <div class="condicion-line"><strong>Lugar de entrega de los bienes:</strong> {{lugarEntrega}}</div>
        </div>
        <div class="firmante-block">
          <div class="atentamente">A T E N T A M E N T E</div>
          {{#if firmanteNombre}}<div class="nombre">{{firmanteNombre}}</div>{{/if}}
          {{#if firmanteCargo}}<div class="nombre">{{firmanteCargo}}</div>{{/if}}
          <div class="nombre">{{firmanteEmpresa}}</div>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

{{else}}
  <div class="page-container">
    <div class="page-bg"><img src="assets/emp12.png" alt="membrete"></div>
    <div class="content-area">
      <div style="text-align:center; padding-top:40px;"><h3>No hay ítems en esta licitación</h3></div>
    </div>
  </div>
{{/if}}

</body>
</html>
